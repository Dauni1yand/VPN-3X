# PostgreSQL
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vpn3x
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vpn:change-me@db:5432/vpn3x

# Redis (background jobs queue for the worker)
REDIS_URL=redis://redis:6379/0

# Fernet key used to encrypt node panel credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# Shared secret the bot uses to call the server's internal API.
INTERNAL_API_KEY=change-me

# Telegram bot
BOT_TOKEN=change-me
# Comma-separated Telegram user IDs allowed to use the admin menu.
BOT_ADMIN_IDS=

# Internal API base URL as seen from the bot container.
SERVER_API_URL=http://server:8000

# Same bot token/admin IDs as above, read directly by the main server (not
# the bot) so it can push node-alert notifications straight to Telegram
# without depending on the bot process being up -- see
# server/app/services/telegram_notifier.py.
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_ADMIN_IDS=

# CryptoBot (Crypto Pay API, https://pay.crypt.bot) is NOT set here on
# purpose -- run /setcryptobottoken <token> in the bot once it's up
# instead (stored encrypted in the settings table, so it can be added or
# rotated without a redeploy).
